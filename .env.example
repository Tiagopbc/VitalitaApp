# .env.example

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_APP_CHECK_DEBUG=false
VITE_ENABLE_SERVER_USER_STATS=false
# Só ative junto com ANTHROPIC_API_KEY e FIREBASE_PROJECT_ID na Vercel (ver MANUAL_TECNICO §7.4)
VITE_ENABLE_PDF_IMPORT=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACING=false
VITE_APP_ENV=
VITE_APP_VERSION=

# --- Variáveis de SERVIDOR (Vercel, não `VITE_`) ---
# Não entram no bundle. Configuradas no painel da Vercel, nunca neste arquivo.
#
# Push de descanso (ver docs/adr/0002-web-push-vapid-qstash-sem-fcm.md):
#   QSTASH_TOKEN          token do QStash; copie junto com a URL, eles são por região
#   QSTASH_URL            endpoint da região da conta (o padrão aponta para eu-central-1)
#   PUSH_INTERNAL_SECRET  segredo que o schedule manda e o send confere
#   VITALITA_BASE_URL     origem pública do app, para o QStash chamar de volta
#   VAPID_PUBLIC_KEY      par da chave pública que está no restPushService
#   VAPID_PRIVATE_KEY     nunca sai da Vercel
#   VAPID_SUBJECT         mailto: de contato (tem padrão no código)
#
# Importação por PDF e autenticação das funções (ver MANUAL_TECNICO §7.4):
#   ANTHROPIC_API_KEY     chave da API da Anthropic
#   FIREBASE_PROJECT_ID   usado para verificar o ID token nos três endpoints
